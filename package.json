{
  "name": "influencer-detective-web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "imports": {
    "#components/*": "./src/components/*.js",
    "#contexts/*": "./src/contexts/*.js",
    "#hooks/*": "./src/hooks/*.js",
    "#services/*": "./src/services/*.js",
    "#types/*": "./src/types/*.js",
    "#utils/*": "./src/utils/*.js"
  },
  "scripts": {
    "build": "tsc -b && vite build",
    "dev": "vite",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "lint": "oxlint",
    "prepare": "husky",
    "preview": "vite preview"
  },
  "dependencies": {
    "@guoyunhe/react-storage": "^2.0.1",
    "@mantine/core": "^9.5.1",
    "@phosphor-icons/react": "^2.1.10",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "wouter": "^3.10.0",
    "xior": "^0.8.4"
  },
  "devDependencies": {
    "@guoyunhe/oxfmt-config": "^1.1.0",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "husky": "^9.1.7",
    "lint-staged": "^17.3.0",
    "oxfmt": "^0.63.0",
    "oxlint": "^1.77.0",
    "typescript": "~6.0.3",
    "vite": "^8.2.1"
  },
  "lint-staged": {
    "*": "oxfmt --write"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "^11.20.0",
      "onFail": "download"
    }
  }
}
